# App Branding & Environment
BRAND_NAME=YourBrand
NODE_ENV=development
API_PORT=3001
PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (with RLS support)
DATABASE_URL=postgresql://linkora_user:linkora_password@localhost:5432/linkora_db

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RECORDINGS=linkora-recordings
S3_BUCKET_UPLOADS=linkora-uploads

# Authentication & JWT Secrets (change for production)
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-linkora-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-minimum-32-chars-linkora
JWT_REFRESH_EXPIRES_IN=7d

# Telephony Provider (MOCK by default, telnyx, twilio)
TELEPHONY_PROVIDER=MOCK
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=

# AI Provider (MOCK by default, gemini)
AI_PROVIDER=MOCK
GEMINI_API_KEY=

# App Branding & Environment
BRAND_NAME=YourBrand
NODE_ENV=development
API_PORT=3001
PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (with RLS support)
DATABASE_URL=postgresql://linkora_user:linkora_password@localhost:5432/linkora_db

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RECORDINGS=linkora-recordings
S3_BUCKET_UPLOADS=linkora-uploads

# Authentication & JWT Secrets (REQUIRED in production, min. 32 random chars each)
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Comma separated list of allowed browser origins for CORS (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:3000

# Password for the built-in demo accounts (disabled in production when empty)
DEMO_USERS_PASSWORD=
# Initial admin password used by the database seed (random if empty in production)
SEED_ADMIN_PASSWORD=

# Telephony Provider (GITASIS, TELNYX, MOCK)
TELEPHONY_PROVIDER=GITASIS
GITASIS_SIP_HOST=
GITASIS_SIP_PORT=5060
GITASIS_SIP_USER=
GITASIS_SIP_PASS=
GITASIS_SIP_REALM=
GITASIS_CALLER_ID=
GITASIS_TRANSPORT=UDP
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=

# API & Webhook Secrets (never commit real values)
LINKORA_TEST_API_KEY=
LINKORA_LIVE_API_KEY=
GITASIS_WEBHOOK_SECRET=
VIPCALL_API_KEY=
VIPCALL_WEBHOOK_SECRET=
VIPCALL_MODE=test
# Tenant that partner API keys and public landing-page inquiries are bound to
API_KEY_TENANT_ID=11111111-1111-1111-1111-111111111111
PUBLIC_INQUIRY_TENANT_ID=11111111-1111-1111-1111-111111111111

# AI Provider (MOCK by default, gemini)
AI_PROVIDER=MOCK
GEMINI_API_KEY=
